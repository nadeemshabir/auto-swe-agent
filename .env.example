# Copy to .env and fill in. Docker Compose reads .env from the project root.
# These are read once at process start: after editing, run
#   docker compose up -d --force-recreate api worker

# ── LLM provider (at least one key) ──────────────────────────────────────────
LLM_PROVIDER=gemini                 # gemini | anthropic
LLM_MODEL=gemini-3.5-flash
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Optional per-role overrides. Empty = fall back to LLM_PROVIDER / LLM_MODEL.
PLANNER_PROVIDER=
PLANNER_MODEL=
CODER_PROVIDER=
CODER_MODEL=
REVIEWER_PROVIDER=
REVIEWER_MODEL=

# ── GitHub ───────────────────────────────────────────────────────────────────
# Token needs write access to contents, pull requests and issues on the target
# repos (plus webhooks, if you use scripts/setup_webhook.sh).
GITHUB_TOKEN=
# Any random string; must match the secret configured on the webhook.
#   python3 -c "import secrets; print(secrets.token_hex(32))"
GITHUB_WEBHOOK_SECRET=

# ── Access control ───────────────────────────────────────────────────────────
# Comma-separated owner/name list. The agent refuses every other repo.
AGENT_REPO_ALLOWLIST=you/your-repo
# Required for the manual trigger (POST /runs). Unset = endpoint disabled.
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_API_TOKEN=

# ── Budget, per run ──────────────────────────────────────────────────────────
MAX_USD=5.0
MAX_STEPS=30
MAX_TOTAL_TOKENS=500000
MAX_WALLCLOCK_S=1800
COMMENT_ON_START=true

# ── Sandbox ──────────────────────────────────────────────────────────────────
# true = run the target repo's tests in a locked-down container (no network,
# read-only, non-root). Build the image first: bash docker/build-sandbox.sh
USE_SANDBOX=false
SANDBOX_IMAGE=auto-swe-sandbox:latest
